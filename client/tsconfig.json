{
  "compilerOptions": {
    "rootDir": "src",
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es5",
    "lib": ["dom", "es2017"],
    "jsx": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["./src"]
}
